    <style>
        /* ==========================================
           1. CSS 變數與基礎重置
           ========================================== */
        :root {
            --bg-deep: #050b14;
            --bg-card: rgba(14, 28, 54, 0.7);
            --primary-blue: #00d2ff;
            --secondary-blue: #0066ff;
            --accent-blue: #3a88ff;
            --glow-blue: rgba(0, 210, 255, 0.5);
            --locked-bg: rgba(255, 255, 255, 0.04);
            --locked-border: rgba(255, 255, 255, 0.12);
            --locked-text: #60728f;
            --text-light: #f0f6ff;
            --text-muted: #8ab4f8;
            --font-main: 'Noto Sans TC', sans-serif;
            --font-tech: 'Orbitron', sans-serif;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            user-select: none;
        }

        body {
            font-family: var(--font-main);
            background-color: var(--bg-deep);
            color: var(--text-light);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 40px 20px;
            position: relative;
            overflow-x: hidden;
        }

        /* 背景流動光暈與科技網格 */
        .bg-grid {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background-image: 
                linear-gradient(rgba(0, 102, 255, 0.07) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0, 102, 255, 0.07) 1px, transparent 1px);
            background-size: 40px 40px;
            z-index: -2;
            pointer-events: none;
        }

        .bg-glow-1, .bg-glow-2 {
            position: fixed;
            border-radius: 50%;
            filter: blur(120px);
            z-index: -1;
            pointer-events: none;
            opacity: 0.6;
        }

        .bg-glow-1 {
            top: -10%;
            left: -10%;
            width: 50vw;
            height: 50vw;
            background: radial-gradient(circle, var(--secondary-blue), transparent 70%);
        }

        .bg-glow-2 {
            bottom: -10%;
            right: -10%;
            width: 60vw;
            height: 60vw;
            background: radial-gradient(circle, var(--primary-blue), transparent 70%);
        }

        /* ==========================================
           2. 主要容器與個人資訊卡 (Profile)
           ========================================== */
.container {
            width: 100%;
            max-width: 1100px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 40px;
        }

        .profile-card {
            background: var(--bg-card);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(0, 210, 255, 0.25);
            border-radius: 24px;
            padding: 35px;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5), 
                        inset 0 0 20px rgba(0, 210, 255, 0.1);
            position: relative;
            max-width: 500px;
            width: 100%;
            transition: transform 0.3s ease;
        }

        .profile-card:hover {
            transform: translateY(-5px);
            border-color: rgba(0, 210, 255, 0.5);
        }

        /* 大頭貼與發光環 */
        .avatar-wrapper {
            position: relative;
            width: 130px;
            height: 130px;
            margin-bottom: 20px;
        }

        .avatar-img {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid var(--primary-blue);
            box-shadow: 0 0 25px var(--glow-blue);
            position: relative;
            z-index: 2;
        }

        .avatar-ring {
            position: absolute;
            top: -8px;
            left: -8px;
            right: -8px;
            bottom: -8px;
            border-radius: 50%;
            border: 2px dashed var(--primary-blue);
            animation: rotateRing 20s linear infinite;
            opacity: 0.7;
        }

        @keyframes rotateRing {
            100% { transform: rotate(360deg); }
        }

        .user-name {
            font-size: 1.8rem;
            font-weight: 900;
            letter-spacing: 1px;
            background: linear-gradient(135deg, #ffffff 0%, var(--primary-blue) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 6px;
        }

        .user-title {
            font-size: 0.95rem;
            color: var(--text-muted);
            font-family: var(--font-tech);
            letter-spacing: 2px;
            margin-bottom: 20px;
        }

        /* 遊戲化經驗條 (EXP) */
        .exp-bar-container {
            width: 100%;
            background: rgba(0, 0, 0, 0.4);
            border-radius: 12px;
            padding: 4px;
            border: 1px solid rgba(0, 210, 255, 0.2);
            position: relative;
        }

        .exp-info {
            display: flex;
            justify-content: space-between;
            font-size: 0.75rem;
            color: var(--text-muted);
font-family: var(--font-tech);
            margin-bottom: 6px;
            padding: 0 4px;
        }

        .exp-bar-bg {
            width: 100%;
            height: 10px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 6px;
            overflow: hidden;
        }

        .exp-bar-fill {
            height: 100%;
            width: 18.75%; /* 3 / 16 關卡進度 */
            background: linear-gradient(90deg, var(--secondary-blue), var(--primary-blue));
            border-radius: 6px;
            box-shadow: 0 0 10px var(--primary-blue);
            transition: width 1s cubic-bezier(0.4, 0, 0.2, 1);
        }

        /* ==========================================
           3. 關卡按鈕網格區域 (Grid)
           ========================================== */
        .grid-section-title {
            align-self: flex-start;
            font-family: var(--font-tech);
            font-size: 1.1rem;
            color: var(--primary-blue);
            letter-spacing: 2px;
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: -20px;
        }

        .grid-section-title::after {
            content: '';
            flex-grow: 1;
            height: 1px;
            background: linear-gradient(90deg, rgba(0, 210, 255, 0.4), transparent);
        }

        .stage-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            width: 100%;
        }

        /* 按鈕基本樣式 */
        .stage-btn {
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            height: 130px;
            padding: 18px;
            border-radius: 16px;
            text-decoration: none;
            color: var(--text-light);
            transition: all 0.35s cubic-bezier(0.25, 1, 0.5, 1);
            overflow: hidden;
            box-sizing: border-box;
        }

        /* === 已解鎖狀態 (Unlocked) === */
        .stage-btn.unlocked {
            background: linear-gradient(145deg, rgba(14, 38, 77, 0.8), rgba(6, 18, 38, 0.9));
            border: 1px solid rgba(0, 210, 255, 0.4);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
            cursor: pointer;
        }

        .stage-btn.unlocked::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(0, 210, 255, 0.2), transparent);
            transition: left 0.6s ease;
        }

        /* 解鎖按鈕懸停動畫 (Hover Effect) */
        .stage-btn.unlocked:hover {
            transform: translateY(-8px) scale(1.02);
            border-color: var(--primary-blue);
            box-shadow: 0 15px 30px rgba(0, 102, 255, 0.35),
0 0 20px rgba(0, 210, 255, 0.4);
        }

        .stage-btn.unlocked:hover::before {
            left: 100%;
        }

        .stage-btn.unlocked:hover .btn-badge {
            background: var(--primary-blue);
            color: #000;
            box-shadow: 0 0 10px var(--primary-blue);
        }

        .stage-btn.unlocked:hover .btn-arrow {
            transform: translateX(5px);
            color: var(--primary-blue);
        }

        /* === 未解鎖狀態 (Locked) === */
        .stage-btn.locked {
            background: var(--locked-bg);
            border: 1px solid var(--locked-border);
            color: var(--locked-text);
            cursor: not-allowed;
            backdrop-filter: blur(4px);
        }

        .stage-btn.locked:hover {
            border-color: rgba(255, 255, 255, 0.25);
            background: rgba(255, 255, 255, 0.06);
        }

        /* 點擊未解鎖時的搖晃動畫 */
        .stage-btn.shake {
            animation: shakeAnim 0.4s ease-in-out;
            border-color: #ff4757 !important;
        }

        @keyframes shakeAnim {
            0%, 100% { transform: translateX(0); }
            20% { transform: translateX(-8px); }
            40% { transform: translateX(8px); }
            60% { transform: translateX(-5px); }
            80% { transform: translateX(5px); }
        }

        /* 內部元件樣式 */
        .btn-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .btn-badge {
            font-family: var(--font-tech);
            font-size: 0.75rem;
            font-weight: 800;
            padding: 4px 10px;
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.08);
            color: var(--text-muted);
            transition: all 0.3s ease;
        }

        .stage-btn.unlocked .btn-badge {
            background: rgba(0, 210, 255, 0.15);
            color: var(--primary-blue);
            border: 1px solid rgba(0, 210, 255, 0.3);
        }

        .btn-status-icon {
            font-size: 1.1rem;
        }

        .btn-title {
            font-size: 1rem;
            font-weight: 700;
            line-height: 1.4;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .stage-btn.unlocked .btn-title {
            color: var(--text-light);
        }

        .btn-footer {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            font-size: 0.85rem;
        }

        .btn-arrow {
            transition: transform 0.3s ease, color 0.3s ease;
        }

        /* ==========================================
           4. 鎖定提示浮層 Notification
           ========================================== */
        .toast {
position: fixed;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%) translateY(100px);
            background: rgba(15, 23, 42, 0.95);
            border: 1px solid #ff4757;
            color: #ff6b81;
            padding: 12px 24px;
            border-radius: 30px;
            box-shadow: 0 10px 30px rgba(255, 71, 87, 0.3);
            font-size: 0.9rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 10px;
            opacity: 0;
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            z-index: 100;
            pointer-events: none;
        }

        .toast.show {
            transform: translateX(-50%) translateY(0);
            opacity: 1;
        }

        /* ==========================================
           5. 響應式排版 (Responsive RWD)
           ========================================== */
        @media (max-width: 992px) {
            .stage-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        @media (max-width: 768px) {
            .stage-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 14px;
            }
            .stage-btn {
                height: 120px;
                padding: 14px;
            }
            .profile-card {
                padding: 25px;
            }
            .user-name {
                font-size: 1.5rem;
            }
        }

        @media (max-width: 480px) {
            .stage-grid {
                grid-template-columns: repeat(1, 1fr);
            }
            body {
                padding: 20px 15px;
            }
        }
    </style>
</head>
